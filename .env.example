# MediaPitch local deployment settings.
# Copy to .env on the server. The real .env is gitignored and blocked by .htaccess.

# Enables authenticated server-to-server and bulk use of /mail-list-cleaner/api.php.
# Use a long random secret and configure the same value as EMAIL_VALIDATOR_API_KEY
# in Fill Masjid and MediaPitch Store.
MAIL_LIST_CLEANER_API_KEY=
