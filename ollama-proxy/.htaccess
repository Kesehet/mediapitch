Options -Indexes
RewriteEngine On

# Never expose application internals or the SQLite database.
RewriteRule ^(?:data|lib\.php|version\.php|config\.php|README\.md)(?:/|$) - [F,L]
<FilesMatch "^(?:\.env|\.env\..*|config\.php|lib\.php|version\.php|README\.md)$">
  Require all denied
</FilesMatch>

# Ollama-compatible proxy endpoints.
RewriteRule ^api/(chat|generate|embed|embeddings|tags|show|ps|version)/?$ api.php?endpoint=$1 [QSA,L]
# OpenAI-compatible paths used by Copilot chat, agents, and custom endpoints.
RewriteRule ^v1/(models|chat/completions|completions|embeddings|responses)/?$ api.php?endpoint=v1/$1 [QSA,L]

# Application pages.
RewriteRule ^login/?$ index.php?action=login [QSA,L]
RewriteRule ^(?:register|apply)/?$ index.php?action=login [R=302,L]
RewriteRule ^logout/?$ index.php?action=logout [QSA,L]
RewriteRule ^admin/?$ admin.php [QSA,L]
RewriteRule ^logs/?$ logs.php [QSA,L]
