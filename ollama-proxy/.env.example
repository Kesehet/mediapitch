# MediaPitch Ollama Proxy
# Copy this file to .env on the server and replace placeholder values.
# Never commit the real .env file.

# Required: stable 32-byte encryption key, base64 encoded.
# Generate with:
# php -r "echo base64_encode(random_bytes(32)), PHP_EOL;"
OLLAMA_PROXY_APP_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Required: one or more real Ollama Cloud API keys.
# For multiple keys, separate them with commas and no surrounding quotes.
OLLAMA_PROXY_UPSTREAM_KEYS=REPLACE_WITH_OLLAMA_CLOUD_KEY

# Required: password for https://mediapitch.in/ollama-proxy/admin
OLLAMA_PROXY_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD

# Ollama Cloud base URL.
OLLAMA_PROXY_UPSTREAM_BASE_URL=https://ollama.com

# Default daily request allowance assigned to users.
# Set to 0 for unlimited requests.
OLLAMA_PROXY_DAILY_REQUEST_LIMIT=100

# Allow new users to submit access applications.
OLLAMA_PROXY_REGISTRATION_ENABLED=true
